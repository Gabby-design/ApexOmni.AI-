                        <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 2L9.19 4.53 5.48 4.79 4.02 8.24 1.34 10.87 2.68 14.39 1.97 18.09 5.34 19.68 7.42 22.79 11.13 22.25 13.9 24.32 16.67 22.25 20.38 22.79 22.46 19.68 25.83 18.09 25.12 14.39 26.46 10.87 23.78 8.24 22.32 4.79 18.61 4.53 15.8 2H12z" transform="scale(0.8) translate(2, 2)"></path>
                        </svg>
                      </div>
                      <div class="text-[10px] text-emerald-400 flex items-center gap-1 font-medium" id="headerSubtitle">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span>Official Business • Online</span>
                      </div>
                    </div>
                  </div>

                  <div class="flex items-center gap-3 text-slate-300">
                    <button aria-label="Audio call" class="hover:text-white">
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                    </button>
                    <button aria-label="Channel details" class="hover:text-white">
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg>
                    </button>
                  </div>
                </div>

                <!-- Chat Messages Screen (Scrollable) -->
                <div id="chatMessages" class="flex-1 p-3.5 space-y-3 overflow-y-auto chat-scroll text-xs">
                  
                  <!-- Encryption Badge / Notice -->
                  <div class="text-center my-1">
                    <span class="inline-block px-3 py-1 rounded bg-black/40 text-[10px] text-slate-400 border border-white/5 font-mono">
                      End-to-end encrypted • 24/7 AI Concierge Ready
                    </span>
                  </div>

                  <!-- Initial AI Greeting Message -->
                  <div class="flex items-start gap-2 max-w-[85%]">
                    <div class="p-3 rounded-2xl rounded-tl-sm bg-[#202C33] text-slate-100 border border-white/5 shadow-sm space-y-1.5" id="aiInitialBubble">
                      <p>
                        Welcome to <strong>Apex Aesthetic &amp; Dental Studio</strong>. I am your 24/7 patient booking concierge.
                      </p>
                      <p class="text-slate-300">
                        How can I assist your schedule today? Select an inquiry below or type a question:
                      </p>
                      <div class="text-[9px] text-slate-400 text-right font-mono">9:41 AM</div>
                    </div>
                  </div>

                  <!-- Container where dynamic messages render -->
                  <div id="dynamicMessages" class="space-y-3"></div>

                  <!-- Typing Indicator Bubble (Hidden by default) -->
                  <div id="typingIndicator" class="hidden flex items-center gap-1.5 p-3 rounded-2xl rounded-tl-sm bg-[#202C33] text-slate-300 border border-white/5 w-20 shadow-sm">
                    <div class="w-1.5 h-1.5 rounded-full bg-emerald-400 typing-dot"></div>
                    <div class="w-1.5 h-1.5 rounded-full bg-emerald-400 typing-dot"></div>
                    <div class="w-1.5 h-1.5 rounded-full bg-emerald-400 typing-dot"></div>
                  </div>

                </div>

                <!-- Bottom Interactive Action Drawer (Clickable Pills) -->
                <div class="p-3 bg-[#111B21] border-t border-white/5 space-y-2.5 z-10" id="chatInputArea">
                  
                  <div class="flex items-center justify-between text-[10px] text-slate-400 font-medium px-0.5">
                    <span>Click a real prospect inquiry to test:</span>
                    <button onclick="resetSimulator()" class="text-emerald-400 hover:text-emerald-300 flex items-center gap-1 font-medium">
                      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
                      <span>Reset Demo</span>
                    </button>
                  </div>

                  <!-- 3 Working Clickable Prompt Pills -->
                  <div class="grid grid-cols-1 gap-1.5" id="promptPillsContainer">
                    <button onclick="handleSimulatorPrompt(1)" class="prompt-pill text-left px-3 py-2 rounded-xl bg-slate-800/80 hover:bg-emerald-500/15 border border-slate-700 hover:border-emerald-500/40 text-[11px] text-slate-200 transition-all flex items-center justify-between group">
                      <span>"Hey, how much is your full smile makeover?"</span>
                      <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-emerald-400 group-hover:translate-x-0.5 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </button>

                    <button onclick="handleSimulatorPrompt(2)" class="prompt-pill text-left px-3 py-2 rounded-xl bg-slate-800/80 hover:bg-emerald-500/15 border border-slate-700 hover:border-emerald-500/40 text-[11px] text-slate-200 transition-all flex items-center justify-between group">
                      <span>"Can I book a consultation for this Saturday?"</span>
                      <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-emerald-400 group-hover:translate-x-0.5 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </button>

                    <button onclick="handleSimulatorPrompt(3)" class="prompt-pill text-left px-3 py-2 rounded-xl bg-slate-800/80 hover:bg-emerald-500/15 border border-slate-700 hover:border-emerald-500/40 text-[11px] text-slate-200 transition-all flex items-center justify-between group">
                      <span>"Do you offer flexible payment plans?"</span>
                      <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-emerald-400 group-hover:translate-x-0.5 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </button>
                  </div>

                  <!-- Quick Contact Autofill Container -->
                  <div id="contactFillContainer" class="hidden space-y-1.5 pt-1">
                    <span class="text-[10px] text-emerald-400 font-semibold block">Prospect verification step:</span>
                    <button onclick="submitProspectContact('Sarah Jenkins', '+1 (555) 234-8901')" class="w-full text-left px-3 py-2 rounded-xl bg-emerald-500/15 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/40 text-[11px] transition-all flex items-center justify-between">
                      <span>Quick Fill: Sarah Jenkins &bull; (555) 234-8901</span>
                      <span class="font-bold text-[10px] bg-emerald-500/20 px-1.5 py-0.5 rounded">Submit &rarr;</span>
                    </button>
                  </div>

                  <!-- Slot Picker Container (Injected dynamically) -->
                  <div id="slotPickerContainer" class="hidden space-y-2 pt-1">
                    <span class="text-[10px] text-emerald-400 font-semibold block">Select appointment slot:</span>
                    <div class="grid grid-cols-3 gap-1.5">
                      <button onclick="selectBookingSlot('11:00 AM')" class="slot-btn py-1.5 px-2 rounded-lg bg-emerald-500/20 hover:bg-emerald-500 text-emerald-300 hover:text-obsidian-900 border border-emerald-500/40 font-mono text-[11px] font-bold transition-all text-center">
                        11:00 AM
                      </button>
                      <button onclick="selectBookingSlot('2:30 PM')" class="slot-btn py-1.5 px-2 rounded-lg bg-emerald-500/20 hover:bg-emerald-500 text-emerald-300 hover:text-obsidian-900 border border-emerald-500/40 font-mono text-[11px] font-bold transition-all text-center">
                        2:30 PM
                      </button>
                      <button onclick="selectBookingSlot('4:00 PM')" class="slot-btn py-1.5 px-2 rounded-lg bg-emerald-500/20 hover:bg-emerald-500 text-emerald-300 hover:text-obsidian-900 border border-emerald-500/40 font-mono text-[11px] font-bold transition-all text-center">
                        4:00 PM
                      </button>
                    </div>
                  </div>

                  <!-- Working Interactive Input Text Bar -->
                  <form onsubmit="handleSimulatorCustomText(event)" class="flex items-center gap-2 pt-1">
                    <input 
                      type="text" 
                      id="simulatorCustomInput" 
                      placeholder="Type custom question or click prompt..."
                      class="flex-1 bg-slate-900/90 rounded-full px-3 py-1.5 border border-slate-700 text-slate-200 text-xs focus:outline-none focus:border-emerald-500"
                    >
                    <button type="submit" class="w-8 h-8 rounded-full bg-emerald-500 hover:bg-emerald-400 text-obsidian-900 flex items-center justify-center shrink-0 transition-colors" aria-label="Send message">
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                    </button>
                  </form>

                </div>

              </div>
            </div>

          </div>

        </div>

      </div>
    </section>

    <!-- ============================================================== -->
    <!-- 4. INTERACTIVE ROI & LOST REVENUE CALCULATOR                    -->
    <!-- ============================================================== -->
    <section id="roi-calculator" class="py-20 md:py-28 relative border-t border-white/[0.06]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Section Header -->
        <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-xs font-semibold text-emerald-400 uppercase tracking-widest">
            <span>Conversion Weapon</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
            Calculate Your Untapped Monthly Revenue
          </h2>
          <p class="text-base sm:text-lg text-slate-300">
            High-ticket inquiries that arrive after 5:00 PM or over the weekend choose whichever provider answers first. See how much you are leaving on the table.
          </p>
        </div>

        <!-- Calculator Card -->
        <div class="max-w-4xl mx-auto glass-panel-elevated rounded-3xl p-6 sm:p-10 border border-white/10 shadow-2xl">
          
          <!-- Presets for Local Businesses -->
          <div class="mb-8">
            <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-400 block mb-2">
              Select High-Ticket Service Benchmark:
            </span>
            <div class="flex flex-wrap gap-2">
              <button onclick="setCalculatorPreset(60, 450)" class="px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-xs text-slate-300 border border-slate-700 hover:border-emerald-500/50 transition-colors">
                Aesthetic Injectables (60 msgs @ $450)
              </button>
              <button onclick="setCalculatorPreset(80, 1200)" class="px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-xs text-slate-300 border border-slate-700 hover:border-emerald-500/50 transition-colors">
                Dental Implants &amp; Veneers (80 msgs @ $1,200)
              </button>
              <button onclick="setCalculatorPreset(100, 350)" class="px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-xs text-slate-300 border border-slate-700 hover:border-emerald-500/50 transition-colors">
                Medspa Studio (100 msgs @ $350)
              </button>
              <button onclick="setCalculatorPreset(45, 1800)" class="px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-xs text-slate-300 border border-slate-700 hover:border-emerald-500/50 transition-colors">
                Roofing &amp; HVAC (45 msgs @ $1,800)
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
            
            <!-- Sliders Column -->
            <div class="lg:col-span-7 space-y-8">
              
              <!-- Slider 1: Inquiries -->
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <label for="sliderInquiries" class="text-sm font-semibold text-slate-200">
                    Estimated inquiries/messages per month:
                  </label>
                  <span class="font-mono text-lg font-bold text-emerald-400 bg-emerald-500/10 px-3 py-0.5 rounded-lg border border-emerald-500/20" id="valInquiries">
                    80 msgs
                  </span>
                </div>
                <input 
                  type="range" 
                  id="sliderInquiries" 
                  min="20" 
                  max="500" 
                  step="5" 
                  value="80" 
                  class="w-full cursor-pointer accent-emerald-500"
                  oninput="updateRoiCalculation()"
                >
                <div class="flex justify-between text-[11px] text-slate-500 font-mono">
                  <span>20 msgs/mo</span>
                  <span>250 msgs/mo</span>
                  <span>500 msgs/mo</span>
                </div>
              </div>

              <!-- Slider 2: Average Booking Value -->
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <label for="sliderValue" class="text-sm font-semibold text-slate-200">
                    Average customer or booking value ($):
                  </label>
                  <span class="font-mono text-lg font-bold text-emerald-400 bg-emerald-500/10 px-3 py-0.5 rounded-lg border border-emerald-500/20" id="valAvgValue">
                    $250
                  </span>
                </div>
                <input 
                  type="range" 
                  id="sliderValue" 
                  min="50" 
                  max="2000" 
                  step="25" 
                  value="250" 
                  class="w-full cursor-pointer accent-emerald-500"
                  oninput="updateRoiCalculation()"
                >
                <div class="flex justify-between text-[11px] text-slate-500 font-mono">
                  <span>$50</span>
                  <span>$1,000</span>
                  <span>$2,000+</span>
                </div>
              </div>

              <!-- Logic Breakdown Micro-Card -->
              <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2 text-xs text-slate-400">
                <div class="flex items-center justify-between">
                  <span>Estimated missed inquiries after hours (~45%):</span>
                  <span class="font-mono text-slate-200 font-semibold" id="statAfterHours">36 leads</span>
                </div>
                <div class="flex items-center justify-between">
                  <span>Instant 3-second reply booking capture rate:</span>
                  <span class="font-mono text-emerald-400 font-semibold">35% conversion</span>
                </div>
                <div class="flex items-center justify-between">
                  <span>Estimated recovered paid appointments per month:</span>
                  <span class="font-mono text-slate-200 font-semibold" id="statRecoveredSlots">13 bookings</span>
                </div>
              </div>

            </div>

            <!-- Dynamic Results Column -->
            <div class="lg:col-span-5 flex flex-col justify-center">
              <div class="p-6 sm:p-8 rounded-2xl bg-gradient-to-b from-slate-900 via-obsidian-900 to-obsidian-950 border border-emerald-500/30 shadow-glow-emerald space-y-6 text-center">
                
                <div>
                  <div class="text-xs uppercase font-mono tracking-widest text-slate-400 font-semibold mb-1">
                    Projected Recovered Revenue per Month
                  </div>
                  <div class="text-4xl sm:text-5xl font-extrabold text-emerald-400 font-mono tracking-tight" id="resultMonthly">
                    $3,250
                  </div>
                  <div class="text-xs text-slate-400 mt-1 font-mono">
                    Annual potential: <span id="resultAnnual" class="text-slate-300 font-semibold">$39,000</span>/year
                  </div>
                </div>

                <div class="py-3 px-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-300">
                  <span class="font-bold" id="resultRoiMultiple">13.0x Projected ROI</span> on our standard $249/mo Omnichannel plan.
                </div>

                <button onclick="openLeadModalWithRoi()" class="w-full py-4 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-obsidian-900 font-bold text-sm tracking-wide shadow-lg shadow-emerald-500/30 transition-all transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
                  <span>Book Bot to Recover This</span>
                  <svg class="w-4 h-4 text-obsidian-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path></svg>
                </button>

                <p class="text-[11px] text-slate-500 leading-tight">
                  Covered by our 5-booking minimum trial guarantee or you pay $0.
                </p>

              </div>
            </div>

          </div>

        </div>

      </div>
    </section>

    <!-- ============================================================== -->
    <!-- 5. PROBLEM VS. SOLUTION (HIGH-IMPACT COMPARISON GRID)          -->
    <!-- ============================================================== -->
    <section id="comparison" class="py-20 md:py-28 relative border-t border-white/[0.06] bg-obsidian-900/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-800 border border-slate-700 text-xs font-semibold text-slate-300 uppercase tracking-widest">
            <span>Direct Comparison</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
            The Costly Old Way vs. The ApexOmni AI Standard
