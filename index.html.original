      <!-- Success State -->
      <div id="modalSuccessContainer" class="hidden text-center py-6 space-y-4">
        <div class="w-16 h-16 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-400/40 flex items-center justify-center mx-auto">
          <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
        <h3 class="text-2xl font-bold text-white">Pilot Request Confirmed</h3>
        <p class="text-xs text-slate-300 max-w-sm mx-auto">
          Thank you! Your business profile has been assigned to our senior integration engineer. We will message your phone shortly with your tailored setup credentials.
        </p>
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
          <button onclick="showLeadTab('cal')" class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-violet-600 hover:bg-violet-500 text-white font-semibold text-xs transition-colors flex items-center justify-center gap-1.5">
            <span>Also Book Calendar Time</span>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path></svg>
          </button>
          <button onclick="closeLeadModal()" class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold text-xs transition-colors">
            Return to Page
          </button>
        </div>
      </div>

    </div>
  </dialog>

  <!-- ============================================================== -->
  <!-- LEGAL COMPLIANCE MODAL (PRIVACY POLICY & TERMS OF SERVICE)     -->
  <!-- ============================================================== -->
  <dialog id="legalModal" class="rounded-3xl bg-transparent p-0 max-w-2xl w-full m-auto focus:outline-none">
    <div class="glass-panel-elevated rounded-3xl p-6 sm:p-8 border border-white/10 shadow-2xl relative text-slate-200 max-h-[85vh] flex flex-col">
      
      <!-- Close Button -->
      <button onclick="closeLegalModal()" class="absolute top-5 right-5 text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800/80 transition-colors" aria-label="Close legal modal">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <!-- Legal Tabs Header -->
      <div class="pr-8 mb-4 border-b border-white/10 pb-4">
        <div class="flex items-center gap-3">
          <button id="legalTabPrivacyBtn" onclick="switchLegalTab('privacy')" class="text-lg font-bold text-white border-b-2 border-emerald-400 pb-1 focus:outline-none">
            Privacy Policy
          </button>
          <button id="legalTabTermsBtn" onclick="switchLegalTab('terms')" class="text-lg font-bold text-slate-400 hover:text-white pb-1 focus:outline-none">
            Terms of Service
          </button>
        </div>
        <p class="text-xs text-slate-400 mt-1">
          Effective Date: October 2026 | ApexOmni AI Enterprise Data Standards
        </p>
      </div>

      <!-- Scrollable Legal Body -->
      <div class="overflow-y-auto chat-scroll pr-2 space-y-5 text-xs text-slate-300 leading-relaxed flex-1">
        
        <!-- Tab: Privacy Policy -->
        <div id="legalPrivacyContent" class="space-y-4">
          <div>
            <h4 class="text-sm font-bold text-white mb-1">1. Architectural Data Commitment</h4>
            <p>
              ApexOmni AI ("we", "us", or "our") installs and manages conversational AI receptionist software for clinics, medspas, and high-ticket service businesses. We act strictly as a B2B Data Processor regarding prospective customer and patient booking inquiries.
            </p>
          </div>

          <div>
            <h4 class="text-sm font-bold text-white mb-1">2. Information Collection &amp; Ingestion</h4>
            <p>
              We process inquiry data submitted through authorized channel webhooks: prospect contact details (name, phone number, email address), desired service or treatment, requested consultation time slots, and communication logs. We do not solicit nor intentionally store sensitive personal health data or payment card numbers through conversation transcripts.
            </p>
          </div>

          <div>
            <h4 class="text-sm font-bold text-white mb-1">3. Zero Model Training on Client Data</h4>
            <p>
              Client inquiry conversations, appointment details, and patient booking requests are processed via isolated enterprise API endpoints. Your customer data is never sold, leased, or utilized to train general public large language models (LLMs).
            </p>
          </div>

          <div>
            <h4 class="text-sm font-bold text-white mb-1">4. Official Platform API Compliance</h4>
            <p>
              All message routing functions strictly through certified developer APIs: Meta Graph API (WhatsApp Business &amp; Instagram DM) and TikTok Business Messaging API. All transmissions utilize TLS 1.3 encryption in transit and AES-256 encryption at rest.
            </p>
          </div>

          <div>
            <h4 class="text-sm font-bold text-white mb-1">5. Clinical &amp; Legal Disclaimers</h4>
            <p>
              ApexOmni AI systems provide automated receptionist triage, schedule booking, and operational FAQs. They do not dispense clinical medical advice, diagnose medical conditions, or establish physician-patient relationships.
            </p>
          </div>

          <div>
            <h4 class="text-sm font-bold text-white mb-1">6. Contact &amp; Data Rights</h4>
            <p>
              For data access requests, deletion, or privacy queries, contact our compliance officer at <span class="text-emerald-400 font-mono">compliance@apexomniai.com</span>.
            </p>
          </div>
        </div>

        <!-- Tab: Terms of Service -->
        <div id="legalTermsContent" class="hidden space-y-4">
          <div>
            <h4 class="text-sm font-bold text-white mb-1">1. Acceptance of Terms</h4>
            <p>
              By accessing ApexOmni AI or engaging our deployment pilots, you agree to these Terms of Service. These terms govern the provision of automated multi-channel receptionist integrations.
            </p>
          </div>

          <div>
            <h4 class="text-sm font-bold text-white mb-1">2. 14-Day Free Pilot &amp; 5-Booking Guarantee</h4>
            <p>
              Eligible businesses receive a 14-day zero-cost trial. Under our Double-Protected Guarantee, if your configured AI receptionist does not book at least 5 verified consultation or quote appointments within 14 calendar days of live channel bridge activation, you owe $0 and may terminate without penalty. This guarantee requires maintaining the AI bot connected to active business traffic channels.
            </p>
          </div>

          <div>
            <h4 class="text-sm font-bold text-white mb-1">3. Client Responsibilities</h4>
            <p>
              Clients are responsible for providing accurate treatment/service pricing ranges, business hours, and operational policies during the initial knowledge sync. Clients must maintain active, good-standing credentials with Meta and connected calendar providers.
            </p>
          </div>

          <div>
            <h4 class="text-sm font-bold text-white mb-1">4. Service Availability &amp; SLAs</h4>
            <p>
              We maintain a 99.9% uptime target for webhook infrastructure and automated message dispatch. Routine maintenance windows are scheduled during low-traffic overnight hours with advance notice.
            </p>
          </div>

          <div>
            <h4 class="text-sm font-bold text-white mb-1">5. Limitation of Liability</h4>
            <p>
              In no event shall ApexOmni AI Ltd be liable for indirect, incidental, or consequential damages resulting from third-party API platform outages (Meta, TikTok, Google) or customer misrepresentations during chat triage.
            </p>
          </div>
        </div>

      </div>

      <div class="pt-4 border-t border-white/10 flex items-center justify-between text-xs">
        <span class="text-slate-500">ApexOmni AI Ltd | Legal Compliance</span>
        <button onclick="closeLegalModal()" class="px-5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold transition-colors">
          I Understand &amp; Close
        </button>
      </div>

    </div>
  </dialog>

  <!-- ============================================================== -->
  <!-- JAVASCRIPT STATE MANAGEMENT & INTERACTION LOGIC                -->
  <!-- ============================================================== -->
  <script>
    // --- Web Audio Synthesizer (Micro-Haptics) ---
    let audioCtx = null;
    let isSoundMuted = false;

    function initAudio() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) {
          audioCtx = new AudioContextClass();
        }
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    function playTone(freq, type = 'sine', duration = 0.08, volume = 0.15) {
      if (isSoundMuted) return;
      initAudio();
      if (!audioCtx) return;

      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);

      gain.gain.setValueAtTime(volume, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);

      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + duration);
    }

    function playSendSound() {
      if (isSoundMuted) return;
      initAudio();
      if (!audioCtx) return;
      // Quick rising pop: 450Hz to 850Hz
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.frequency.setValueAtTime(450, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(850, audioCtx.currentTime + 0.06);
      gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.07);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + 0.07);
    }

    function playReceiveSound() {
      if (isSoundMuted) return;
      initAudio();
      if (!audioCtx) return;
      // Gentle double chime
      playTone(587.33, 'sine', 0.09, 0.1);
      setTimeout(() => playTone(880, 'sine', 0.12, 0.08), 70);
    }

    function playConfirmSound() {
      if (isSoundMuted) return;
      initAudio();
      if (!audioCtx) return;
      // Success triad: C5 (523Hz), E5 (659Hz), G5 (784Hz)
      playTone(523.25, 'sine', 0.12, 0.12);
      setTimeout(() => playTone(659.25, 'sine', 0.12, 0.12), 90);
      setTimeout(() => playTone(783.99, 'sine', 0.25, 0.15), 180);
    }

    function toggleSoundFx() {
      isSoundMuted = !isSoundMuted;
      const iconOn = document.getElementById('soundIconOn');
      const iconOff = document.getElementById('soundIconOff');
      const label = document.getElementById('soundLabel');

      if (isSoundMuted) {
        iconOn.classList.add('hidden');
        iconOff.classList.remove('hidden');
        label.textContent = 'Sound: MUTED';
        label.classList.remove('text-emerald-400');
        label.classList.add('text-slate-500');
      } else {
        iconOn.classList.remove('hidden');
        iconOff.classList.add('hidden');
        label.textContent = 'Sound: ON';
        label.classList.remove('text-slate-500');
        label.classList.add('text-emerald-400');
        playTone(600, 'sine', 0.08, 0.1);
      }
    }

    // --- Mobile Menu Toggle ---
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');

    mobileMenuBtn?.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    function closeMobileMenu() {
      mobileMenu.classList.add('hidden');
    }

    // --- Simulator Channel State ---
    let currentChannel = 'whatsapp';
    let isWaitingForAi = false;
    let selectedPromptIndex = null;
    let capturedContact = null;

    const channelConfigs = {
      whatsapp: {
        title: 'Apex Clinic AI',
        subtitle: 'Official Business • Online',
        avatarText: 'AO',
        screenBg: '#0B141A',
        headerBg: '#1F2C34',
        userBubbleBg: '#005C4B',
        aiBubbleBg: '#202C33',
        placeholder: 'WhatsApp message...',
        greeting: 'Welcome to Apex Aesthetic & Dental Studio. I am your 24/7 patient booking concierge. How can I assist your schedule today?',
        activeColor: 'emerald'
      },
      instagram: {
        title: 'apexomni.clinic',
        subtitle: 'Active now • Verified',
        avatarText: 'IG',
        screenBg: '#000000',
        headerBg: '#121212',
        userBubbleBg: '#3797F0',
        aiBubbleBg: '#262626',
        placeholder: 'Message...',
        greeting: 'Hey there! Thanks for visiting our Instagram. Looking to book an aesthetic or dental consultation? I can lock your slot in right now.',
        activeColor: 'pink'
      },
      tiktok: {
        title: 'apexomni_reception',
        subtitle: 'Official Account • 24/7 Bot',
        avatarText: 'TT',
        screenBg: '#121212',
        headerBg: '#181818',
        userBubbleBg: '#FE2C55',
        aiBubbleBg: '#2F2F2F',
        placeholder: 'Send TikTok inquiry...',
        greeting: 'Hey! Saw our latest transformation video? Ask me anything about treatments, pricing, or available consult times.',
        activeColor: 'cyan'
      },
      webwidget: {
        title: 'Apex Patient Concierge',
        subtitle: 'Typical reply: 3 seconds',
        avatarText: 'WB',
        screenBg: '#0F172A',
        headerBg: '#1E293B',
        userBubbleBg: '#6366F1',
        aiBubbleBg: '#1E293B',
        placeholder: 'Type your question...',
        greeting: 'Good day! Welcome to ApexOmni Clinic Concierge. We are live 24/7 to answer pricing questions and book appointment slots.',
        activeColor: 'violet'
      }
    };

    function switchSimulatorChannel(channelKey) {
      if (!channelConfigs[channelKey]) return;
      currentChannel = channelKey;
      playTone(700, 'sine', 0.05, 0.08);

      // Update Tab Styles
      const allTabs = document.querySelectorAll('.channel-tab');
      allTabs.forEach(tab => {
        tab.classList.remove('border-emerald-500/50', 'shadow-glow-emerald', 'border-pink-500/50', 'border-[#25F4EE]/50', 'border-violet-500/50', 'bg-slate-900/80');
        tab.classList.add('bg-slate-900/40', 'border-white/5');
        const indicator = tab.querySelector('.active-indicator');
        if (indicator) indicator.classList.add('hidden');
      });

      const selectedTab = document.getElementById(`tab-${channelKey}`);
      if (selectedTab) {
        selectedTab.classList.remove('bg-slate-900/40', 'border-white/5');
        selectedTab.classList.add('bg-slate-900/80');
        
        if (channelKey === 'whatsapp') {
          selectedTab.classList.add('border-emerald-500/50', 'shadow-glow-emerald');
        } else if (channelKey === 'instagram') {
          selectedTab.classList.add('border-pink-500/50');
        } else if (channelKey === 'tiktok') {
          selectedTab.classList.add('border-[#25F4EE]/50');
        } else if (channelKey === 'webwidget') {
          selectedTab.classList.add('border-violet-500/50');
        }

        const indicator = selectedTab.querySelector('.active-indicator');
        if (indicator) indicator.classList.remove('hidden');
      }

      // Update Phone Colors & Content
      const cfg = channelConfigs[channelKey];
      const phoneScreen = document.getElementById('phoneScreen');
      const channelHeader = document.getElementById('channelHeader');
      const headerTitle = document.getElementById('headerTitle');
      const headerSubtitle = document.getElementById('headerSubtitle');
      const headerAvatarText = document.getElementById('headerAvatarText');
      const aiInitialBubble = document.getElementById('aiInitialBubble');
      const customInput = document.getElementById('simulatorCustomInput');

      if (phoneScreen) phoneScreen.style.backgroundColor = cfg.screenBg;
      if (channelHeader) channelHeader.style.backgroundColor = cfg.headerBg;
      if (headerTitle) headerTitle.textContent = cfg.title;
      if (headerSubtitle) headerSubtitle.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span><span>${cfg.subtitle}</span>`;
      if (headerAvatarText) headerAvatarText.textContent = cfg.avatarText;
      if (customInput) customInput.placeholder = cfg.placeholder;

      if (aiInitialBubble) {
        aiInitialBubble.style.backgroundColor = cfg.aiBubbleBg;
        aiInitialBubble.innerHTML = `
          <p>${cfg.greeting}</p>
          <div class="text-[9px] text-slate-400 text-right font-mono">9:41 AM</div>
        `;
      }

      resetSimulator(false);
    }

    // --- Simulator Chat Flow ---
    const promptAnswers = {
      1: {
        user: "Hey, how much is your full smile makeover?",
        ai: "Our complete smile makeover packages start with an initial 3D digital scan & specialist assessment. Most customized treatment plans range from $2,800 to $5,500 with zero-interest financing. Would you like to reserve a 30-min VIP consultation to view your personalized 3D preview?",
        askContact: "To hold your consultation slot, could you confirm your full name and best mobile number?"
      },
      2: {
        user: "Can I book a consultation for this Saturday?",
        ai: "Yes! Our senior clinicians have 3 priority consultation openings remaining for this Saturday. Every booking includes a complimentary 3D scan and tailored treatment roadmap.",
        askContact: "What is your full name and phone number so I can secure your appointment file?"
      },
      3: {
        user: "Do you offer flexible payment plans?",
        ai: "Absolutely. We provide 0% APR financing through 6, 12, or 24-month installments with instant soft-credit pre-approval that does not affect your credit score.",
        askContact: "To reserve an assessment slot to review your customized financing plan, what is your full name and contact number?"
      }
    };

    function handleSimulatorPrompt(index) {
      if (isWaitingForAi) return;
      isWaitingForAi = true;
      selectedPromptIndex = index;
      playSendSound();

      const data = promptAnswers[index];
      const cfg = channelConfigs[currentChannel];
      const dynamicMessages = document.getElementById('dynamicMessages');
      const typingIndicator = document.getElementById('typingIndicator');
      const chatMessages = document.getElementById('chatMessages');
      const pillsContainer = document.getElementById('promptPillsContainer');
      const contactFillContainer = document.getElementById('contactFillContainer');

      // 1. Render User Message Bubble
      const userBubble = document.createElement('div');
      userBubble.className = 'flex items-end justify-end max-w-[85%] ml-auto';
      userBubble.innerHTML = `
        <div class="p-3 rounded-2xl rounded-tr-sm text-white shadow-sm space-y-1" style="background-color: ${cfg.userBubbleBg};">
          <p>${data.user}</p>
          <div class="text-[9px] text-white/70 text-right font-mono">Just now &bull; ✓✓</div>
        </div>
      `;
      dynamicMessages.appendChild(userBubble);
      chatMessages.scrollTop = chatMessages.scrollHeight;

      // 2. Hide prompt pills and show typing indicator
      if (pillsContainer) pillsContainer.classList.add('hidden');
      if (typingIndicator) typingIndicator.classList.remove('hidden');
      chatMessages.scrollTop = chatMessages.scrollHeight;

      // 3. 600ms Realistic Typing Delay
      setTimeout(() => {
        if (typingIndicator) typingIndicator.classList.add('hidden');
        playReceiveSound();

        // AI Response Bubble
        const aiBubble = document.createElement('div');
        aiBubble.className = 'flex items-start gap-2 max-w-[85%]';
        aiBubble.innerHTML = `
          <div class="p-3 rounded-2xl rounded-tl-sm text-slate-100 border border-white/5 shadow-sm space-y-2" style="background-color: ${cfg.aiBubbleBg};">
            <p>${data.ai}</p>
            <p class="font-semibold text-emerald-300">${data.askContact}</p>
            <div class="text-[9px] text-slate-400 text-right font-mono">Just now</div>
          </div>
        `;
        dynamicMessages.appendChild(aiBubble);

        if (contactFillContainer) {
          contactFillContainer.classList.remove('hidden');
        }

        chatMessages.scrollTop = chatMessages.scrollHeight;
        isWaitingForAi = false;
      }, 600);
    }

    function submitProspectContact(name, phone) {
      capturedContact = { name, phone };
      playSendSound();

      const dynamicMessages = document.getElementById('dynamicMessages');
      const contactFillContainer = document.getElementById('contactFillContainer');
      const slotPickerContainer = document.getElementById('slotPickerContainer');
      const chatMessages = document.getElementById('chatMessages');
      const cfg = channelConfigs[currentChannel];

      if (contactFillContainer) contactFillContainer.classList.add('hidden');

      const userBubble = document.createElement('div');
      userBubble.className = 'flex items-end justify-end max-w-[85%] ml-auto';
      userBubble.innerHTML = `
        <div class="p-2.5 px-3 rounded-2xl rounded-tr-sm text-white text-xs shadow-sm" style="background-color: ${cfg.userBubbleBg};">
          ${name} &bull; ${phone}
        </div>
      `;
      dynamicMessages.appendChild(userBubble);

      const typingIndicator = document.getElementById('typingIndicator');
      if (typingIndicator) typingIndicator.classList.remove('hidden');
      chatMessages.scrollTop = chatMessages.scrollHeight;

      setTimeout(() => {
        if (typingIndicator) typingIndicator.classList.add('hidden');
        playReceiveSound();

        const aiBubble = document.createElement('div');
        aiBubble.className = 'flex items-start gap-2 max-w-[85%]';
        aiBubble.innerHTML = `
          <div class="p-3 rounded-2xl rounded-tl-sm text-slate-100 border border-white/5 shadow-sm space-y-2" style="background-color: ${cfg.aiBubbleBg};">
            <p>Thank you, ${name.split(' ')[0]}! I checked our live calendar. Our senior specialist has 3 priority consultation openings for this Saturday:</p>
            <p class="font-semibold text-emerald-300">Which time slot works best for you?</p>
            <div class="text-[9px] text-slate-400 text-right font-mono">Just now</div>
          </div>
        `;
        dynamicMessages.appendChild(aiBubble);

        if (slotPickerContainer) slotPickerContainer.classList.remove('hidden');
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }, 550);
    }

    function selectBookingSlot(slotTime) {
      playSendSound();
      const dynamicMessages = document.getElementById('dynamicMessages');
      const slotPickerContainer = document.getElementById('slotPickerContainer');
      const chatMessages = document.getElementById('chatMessages');
      const cfg = channelConfigs[currentChannel];

      if (slotPickerContainer) slotPickerContainer.classList.add('hidden');

      const userBubble = document.createElement('div');
      userBubble.className = 'flex items-end justify-end max-w-[85%] ml-auto';
      userBubble.innerHTML = `
        <div class="p-2.5 px-3 rounded-2xl rounded-tr-sm text-white font-mono text-xs shadow-sm" style="background-color: ${cfg.userBubbleBg};">
          Let's lock in Saturday, ${slotTime}
        </div>
      `;
      dynamicMessages.appendChild(userBubble);

      const typingIndicator = document.getElementById('typingIndicator');
      if (typingIndicator) typingIndicator.classList.remove('hidden');
      chatMessages.scrollTop = chatMessages.scrollHeight;

      setTimeout(() => {
        if (typingIndicator) typingIndicator.classList.add('hidden');
        playConfirmSound();

        const contactName = capturedContact ? capturedContact.name : 'Sarah Jenkins';

        // Confirmation Card inside Chat
        const confirmationBubble = document.createElement('div');
        confirmationBubble.className = 'w-full my-2 p-3.5 rounded-2xl bg-emerald-950/90 border border-emerald-500/60 shadow-glow-emerald space-y-2 text-slate-100';
        confirmationBubble.innerHTML = `
          <div class="flex items-center gap-2 text-emerald-400 font-bold text-xs">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Appointment Reserved! Calendar invite &amp; WhatsApp reminder dispatched.</span>
          </div>
          <div class="text-[11px] text-slate-200 leading-tight space-y-1 pt-1 border-t border-emerald-500/20">
            <div><strong>Patient / Client:</strong> ${contactName}</div>
            <div><strong>Date &amp; Time:</strong> This Saturday @ ${slotTime}</div>
            <div><strong>Practitioner:</strong> Dr. Vance (Senior Clinical Director)</div>
            <div><strong>Location:</strong> Apex Central Clinic / Private Suite 4B</div>
            <div class="text-[10px] text-emerald-300 font-mono mt-1">Calendar status: Confirmed &amp; Synced</div>
          </div>
        `;
        dynamicMessages.appendChild(confirmationBubble);
        chatMessages.scrollTop = chatMessages.scrollHeight;

        // Trigger Floating Push Notification Banner
        triggerPushBanner(contactName, slotTime);
      }, 500);
    }

    function triggerPushBanner(name, slotTime) {
      const banner = document.getElementById('phoneNotificationBanner');
      const body = document.getElementById('notifBannerBody');
      if (!banner) return;

      if (body) {
        body.textContent = `Saturday ${slotTime} • ${name} • Calendar synced & 24h SMS active.`;
      }

      banner.classList.remove('-translate-y-28', 'opacity-0', 'pointer-events-none');
      banner.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        banner.classList.remove('translate-y-0', 'opacity-100');
        banner.classList.add('-translate-y-28', 'opacity-0', 'pointer-events-none');
      }, 4500);
    }

    function handleSimulatorCustomText(e) {
      e.preventDefault();
      const input = document.getElementById('simulatorCustomInput');
      const text = input.value.trim();
      if (!text || isWaitingForAi) return;

      input.value = '';
      isWaitingForAi = true;
      playSendSound();

      const dynamicMessages = document.getElementById('dynamicMessages');
      const typingIndicator = document.getElementById('typingIndicator');
      const chatMessages = document.getElementById('chatMessages');
      const cfg = channelConfigs[currentChannel];
      const pillsContainer = document.getElementById('promptPillsContainer');

      if (pillsContainer) pillsContainer.classList.add('hidden');

      const userBubble = document.createElement('div');
      userBubble.className = 'flex items-end justify-end max-w-[85%] ml-auto';
      userBubble.innerHTML = `
        <div class="p-3 rounded-2xl rounded-tr-sm text-white shadow-sm space-y-1" style="background-color: ${cfg.userBubbleBg};">
          <p>${text}</p>
          <div class="text-[9px] text-white/70 text-right font-mono">Just now &bull; ✓✓</div>
        </div>
      `;
      dynamicMessages.appendChild(userBubble);

      if (typingIndicator) typingIndicator.classList.remove('hidden');
      chatMessages.scrollTop = chatMessages.scrollHeight;

      setTimeout(() => {
        if (typingIndicator) typingIndicator.classList.add('hidden');
        playReceiveSound();

        const aiBubble = document.createElement('div');
        aiBubble.className = 'flex items-start gap-2 max-w-[85%]';
        aiBubble.innerHTML = `
          <div class="p-3 rounded-2xl rounded-tl-sm text-slate-100 border border-white/5 shadow-sm space-y-2" style="background-color: ${cfg.aiBubbleBg};">
            <p>Thanks for your message! Our clinical team specializes in personalized treatment plans with 0% APR financing options. We have 3 openings remaining for private consultations this Saturday.</p>
            <p class="font-semibold text-emerald-300">What is your full name and best mobile number so I can secure your priority slot?</p>
            <div class="text-[9px] text-slate-400 text-right font-mono">Just now</div>
          </div>
        `;
        dynamicMessages.appendChild(aiBubble);

        const contactFillContainer = document.getElementById('contactFillContainer');
        if (contactFillContainer) contactFillContainer.classList.remove('hidden');

        chatMessages.scrollTop = chatMessages.scrollHeight;
        isWaitingForAi = false;
      }, 600);
    }

    function resetSimulator(resetChannel = true) {
      playTone(500, 'sine', 0.05, 0.06);
      const dynamicMessages = document.getElementById('dynamicMessages');
      const typingIndicator = document.getElementById('typingIndicator');
      const pillsContainer = document.getElementById('promptPillsContainer');
      const contactFillContainer = document.getElementById('contactFillContainer');
      const slotPickerContainer = document.getElementById('slotPickerContainer');

      if (dynamicMessages) dynamicMessages.innerHTML = '';
      if (typingIndicator) typingIndicator.classList.add('hidden');
      if (pillsContainer) pillsContainer.classList.remove('hidden');
      if (contactFillContainer) contactFillContainer.classList.add('hidden');
      if (slotPickerContainer) slotPickerContainer.classList.add('hidden');
      isWaitingForAi = false;
      capturedContact = null;
    }

    // --- Interactive ROI Calculator with Dynamic Track Gradient ---
    function updateRoiCalculation() {
      const sliderInquiries = document.getElementById('sliderInquiries');
      const sliderValue = document.getElementById('sliderValue');
      const valInquiries = document.getElementById('valInquiries');
      const valAvgValue = document.getElementById('valAvgValue');

      const inquiries = parseInt(sliderInquiries.value, 10);
      const avgValue = parseInt(sliderValue.value, 10);

      // Dynamic Slider Track Gradient Fill
      const inqMin = parseInt(sliderInquiries.min, 10);
      const inqMax = parseInt(sliderInquiries.max, 10);
      const inqPct = ((inquiries - inqMin) / (inqMax - inqMin)) * 100;
      sliderInquiries.style.background = `linear-gradient(to right, #10B981 0%, #10B981 ${inqPct}%, #1E293B ${inqPct}%, #1E293B 100%)`;

      const valMin = parseInt(sliderValue.min, 10);
      const valMax = parseInt(sliderValue.max, 10);
      const valPct = ((avgValue - valMin) / (valMax - valMin)) * 100;
      sliderValue.style.background = `linear-gradient(to right, #10B981 0%, #10B981 ${valPct}%, #1E293B ${valPct}%, #1E293B 100%)`;

      valInquiries.textContent = `${inquiries} msgs`;
      valAvgValue.textContent = `$${avgValue.toLocaleString()}`;

      // Mathematical Model:
      // ~45% of customer inquiries arrive after 5:00 PM or on weekends
      const afterHoursLeads = Math.round(inquiries * 0.45);
      // Fast automated 3-second booking captures ~35% into confirmed consults
      const recoveredAppointments = Math.max(1, Math.round(afterHoursLeads * 0.35));
      // Projected monthly recovered revenue
      const monthlyRecovered = recoveredAppointments * avgValue;
      const annualRecovered = monthlyRecovered * 12;

      // Plan comparison ($249/mo Omnichannel plan)
      const roiMultiple = (monthlyRecovered / 249).toFixed(1);

      document.getElementById('statAfterHours').textContent = `${afterHoursLeads} leads`;
      document.getElementById('statRecoveredSlots').textContent = `${recoveredAppointments} bookings`;
      document.getElementById('resultMonthly').textContent = `$${monthlyRecovered.toLocaleString()}`;
      document.getElementById('resultAnnual').textContent = `$${annualRecovered.toLocaleString()}`;
      document.getElementById('resultRoiMultiple').textContent = `${roiMultiple}x Projected ROI`;
    }

    function setCalculatorPreset(inquiries, avgValue) {
      playTone(650, 'sine', 0.05, 0.08);
      document.getElementById('sliderInquiries').value = inquiries;
      document.getElementById('sliderValue').value = avgValue;
      updateRoiCalculation();
    }

    // Initial calculation
    updateRoiCalculation();

    // --- Billing Period Toggle (Monthly / Annual) ---
    let isAnnualBilling = false;
    function toggleBillingPeriod() {
      isAnnualBilling = !isAnnualBilling;
      playTone(isAnnualBilling ? 750 : 500, 'sine', 0.06, 0.08);
      const toggleCircle = document.getElementById('billingToggleCircle');
      const labelMonthly = document.getElementById('billingLabelMonthly');
      const labelAnnual = document.getElementById('billingLabelAnnual');
      const priceElements = document.querySelectorAll('.price-val-monthly');

      if (isAnnualBilling) {
        toggleCircle.style.transform = 'translateX(28px)';
        labelMonthly.classList.remove('text-white');
        labelMonthly.classList.add('text-slate-400');
        labelAnnual.classList.remove('text-slate-400');
        labelAnnual.classList.add('text-white');
        priceElements.forEach(el => {
          el.textContent = el.getAttribute('data-annual');
        });
      } else {
        toggleCircle.style.transform = 'translateX(0px)';
        labelMonthly.classList.add('text-white');
        labelMonthly.classList.remove('text-slate-400');
        labelAnnual.classList.add('text-slate-400');
        labelAnnual.classList.remove('text-white');
        priceElements.forEach(el => {
          el.textContent = el.getAttribute('data-monthly');
        });
      }
    }

    // ==============================================================
    // BACKEND CONFIGURATION & LEAD SUBMISSION HANDLERS
    // ==============================================================

    // Production Form Endpoint Configuration:
    // To route inquiries to your email inbox, insert your free Web3Forms access key below.
    // Obtain your free key in 10 seconds at: https://web3forms.com (No registration required).
    const WEB3FORMS_ACCESS_KEY = ''; // e.g. 'YOUR_ACCESS_KEY_HERE'
    // Optional Webhook URL (Make.com, Zapier, n8n, GoHighLevel, or Discord):
    const WEBHOOK_ENDPOINT_URL = ''; // e.g. 'https://hook.us1.make.com/...'

    // --- Lead Modal Tab & View State ---
    const leadModal = document.getElementById('leadModal');

    function showLeadTab(tab) {
      playTone(600, 'sine', 0.04, 0.08);
      const formContainer = document.getElementById('modalFormContainer');
      const calContainer = document.getElementById('modalCalContainer');
      const successContainer = document.getElementById('modalSuccessContainer');
      const btnForm = document.getElementById('tabLeadFormBtn');
      const btnCal = document.getElementById('tabLeadCalBtn');

      successContainer.classList.add('hidden');

      if (tab === 'form') {
        formContainer.classList.remove('hidden');
        calContainer.classList.add('hidden');
        btnForm.classList.add('bg-emerald-500', 'text-obsidian-900', 'font-bold');
        btnForm.classList.remove('text-slate-400');
        btnCal.classList.remove('bg-emerald-500', 'text-obsidian-900', 'font-bold');
        btnCal.classList.add('text-slate-400');
      } else {
        formContainer.classList.add('hidden');
        calContainer.classList.remove('hidden');
        btnCal.classList.add('bg-violet-600', 'text-white', 'font-bold');
        btnCal.classList.remove('text-slate-400');
        btnForm.classList.remove('bg-emerald-500', 'text-obsidian-900', 'font-bold');
        btnForm.classList.add('text-slate-400');
      }
    }

    function openLeadModal(sourceContext = 'General CTA') {
      playTone(550, 'sine', 0.05, 0.08);
      document.getElementById('formSourceContext').value = sourceContext;
      showLeadTab('form');
      document.getElementById('modalRoiBadge').classList.add('hidden');
      document.getElementById('leadFormError').classList.add('hidden');
      leadModal.showModal();
    }

    function openLeadModalWithRoi() {
      const recoveredAmt = document.getElementById('resultMonthly').textContent;
      const annualAmt = document.getElementById('resultAnnual').textContent;
      const badge = document.getElementById('modalRoiBadge');
      if (badge) {
        badge.textContent = `Target Recovery: ${recoveredAmt}/mo (${annualAmt}/yr)`;
        badge.classList.remove('hidden');
      }
      openLeadModal(`ROI Calculator Recovery: ${recoveredAmt}/mo`);
    }

    function closeLeadModal() {
      leadModal.close();
    }

    leadModal.addEventListener('click', (e) => {
      const rect = leadModal.getBoundingClientRect();
      const isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height
        && rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
      if (!isInDialog) {
        leadModal.close();
      }
    });

    // --- Cal.com Integration Trigger ---
    function triggerCalEmbed() {
      playTone(700, 'sine', 0.05, 0.1);
      if (window.Cal) {
        window.Cal('modal', {
          calLink: 'apexomniai/audit',
          config: { layout: 'month_view' }
        });
      } else {
        window.open('https://cal.com', '_blank');
      }
    }

    // --- Asynchronous Production Lead Submission ---
    async function handleLeadSubmit(event) {
      event.preventDefault();
      const submitBtn = document.getElementById('leadSubmitBtn');
      const submitText = document.getElementById('leadSubmitText');
      const submitSpinner = document.getElementById('leadSubmitSpinner');
      const errorContainer = document.getElementById('leadFormError');

      const businessName = document.getElementById('leadBusinessName').value.trim();
      const industry = document.getElementById('leadIndustry').value;
      const primaryChannel = document.getElementById('leadPrimaryChannel').value;
      const email = document.getElementById('leadEmail').value.trim();
      const phone = document.getElementById('leadPhone').value.trim();
      const source = document.getElementById('formSourceContext').value;
      const targetRecovery = document.getElementById('resultMonthly') ? document.getElementById('resultMonthly').textContent : 'N/A';

      errorContainer.classList.add('hidden');
      submitBtn.disabled = true;
      submitText.textContent = 'Securing Pilot Allocation...';
      submitSpinner.classList.remove('hidden');

      const payload = {
        access_key: WEB3FORMS_ACCESS_KEY,
        subject: `ApexOmni AI Pilot Application: ${businessName} (${industry})`,
        from_name: 'ApexOmni AI Ingestion Gate',
        business_name: businessName,
        industry: industry,
        priority_channel: primaryChannel,
        work_email: email,
        mobile_phone: phone,
        lead_source: source,
        estimated_monthly_recovery: targetRecovery,
        submitted_at: new Date().toISOString()
      };

      try {
        if (WEB3FORMS_ACCESS_KEY && WEB3FORMS_ACCESS_KEY.length > 5) {
          const response = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(payload)
          });
          const result = await response.json();
          if (!result.success) {
            throw new Error(result.message || 'Submission failed');
          }
        } else if (WEBHOOK_ENDPOINT_URL && WEBHOOK_ENDPOINT_URL.startsWith('http')) {
          await fetch(WEBHOOK_ENDPOINT_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        } else {
          // Local/Demo Mode Fallback: Simulate realistic 600ms network roundtrip
          await new Promise(resolve => setTimeout(resolve, 600));
          console.info('ApexOmni Lead Ingestion [Demo Mode - To deliver to inbox, add WEB3FORMS_ACCESS_KEY]:', payload);
        }

        playConfirmSound();
        document.getElementById('modalFormContainer').classList.add('hidden');
        document.getElementById('modalSuccessContainer').classList.remove('hidden');
        document.getElementById('pilotLeadForm').reset();
      } catch (err) {
        console.error('Lead submission failure:', err);
        errorContainer.textContent = 'Transmission error. Please check your network or message our WhatsApp directly.';
        errorContainer.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitText.textContent = 'Deploy My 14-Day Free Pilot';
        submitSpinner.classList.add('hidden');
      }
    }

    // --- Legal Modal Handling (Privacy & Terms) ---
    const legalModal = document.getElementById('legalModal');

    function openLegalModal(tab = 'privacy') {
      playTone(520, 'sine', 0.05, 0.08);
      switchLegalTab(tab);
      legalModal.showModal();
    }

    function switchLegalTab(tab) {
      const privacyContent = document.getElementById('legalPrivacyContent');
      const termsContent = document.getElementById('legalTermsContent');
      const tabPrivacyBtn = document.getElementById('legalTabPrivacyBtn');
      const tabTermsBtn = document.getElementById('legalTabTermsBtn');

      if (tab === 'privacy') {
        privacyContent.classList.remove('hidden');
        termsContent.classList.add('hidden');
        tabPrivacyBtn.className = 'text-lg font-bold text-white border-b-2 border-emerald-400 pb-1 focus:outline-none';
        tabTermsBtn.className = 'text-lg font-bold text-slate-400 hover:text-white pb-1 focus:outline-none';
      } else {
        termsContent.classList.remove('hidden');
        privacyContent.classList.add('hidden');
        tabTermsBtn.className = 'text-lg font-bold text-white border-b-2 border-emerald-400 pb-1 focus:outline-none';
        tabPrivacyBtn.className = 'text-lg font-bold text-slate-400 hover:text-white pb-1 focus:outline-none';
      }
    }

    function closeLegalModal() {
      legalModal.close();
    }

    legalModal.addEventListener('click', (e) => {
      const rect = legalModal.getBoundingClientRect();
      const isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height
        && rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
      if (!isInDialog) {
        legalModal.close();
      }
    });

    // --- Floating Chat Popover ---
    const floatingChatWindow = document.getElementById('floatingChatWindow');

    function toggleFloatingChat() {
      playTone(500, 'sine', 0.05, 0.08);
      floatingChatWindow.classList.toggle('hidden');
    }

    function floatingChatReply(userText) {
      playSendSound();
      const container = document.getElementById('floatingChatContent');
      const userMsg = document.createElement('div');
      userMsg.className = 'p-2.5 rounded-xl rounded-tr-sm bg-emerald-600 text-white text-right font-medium text-[11px] ml-auto max-w-[85%]';
      userMsg.textContent = userText;
      container.appendChild(userMsg);

      setTimeout(() => {
        playReceiveSound();
        const botMsg = document.createElement('div');
        botMsg.className = 'p-3 rounded-xl rounded-tl-sm bg-slate-800 text-slate-200 border border-white/5 space-y-1.5';
        botMsg.innerHTML = `
          <p>Our 14-day free pilot deploys a trained bot to your channels. If it doesn't book at least 5 appointments during the 14 days, you pay $0.</p>
          <button onclick="openLeadModal('Floating Assistant Pilot Claim')" class="mt-1 px-3 py-1.5 rounded-lg bg-emerald-500 text-obsidian-900 font-bold text-[10px]">
            Claim 14-Day Pilot Now
          </button>
        `;
        container.appendChild(botMsg);
        container.scrollTop = container.scrollHeight;
      }, 500);
    }

    // --- Interactive Mouse Spotlight Highlight on Glass Panels ---
    document.addEventListener('mousemove', (e) => {
      const cards = document.querySelectorAll('.glass-panel');
      cards.forEach(card => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  </script>
</body>
</html>
