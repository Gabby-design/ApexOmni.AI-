<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ApexOmni AI | 24/7 AI-Powered Booking Receptionists for High-Ticket Local Businesses</title>
  <meta name="description" content="Turn every DM, comment, and midnight website visit into confirmed, paid appointments. ApexOmni AI deploys 24/7 AI booking receptionists across Website Chat, WhatsApp Business, Instagram DMs, and TikTok.">
  <meta name="theme-color" content="#0B0F19">
  <link rel="canonical" href="https://apexomniai.com/">

  <!-- Inline Vector Favicon (Monogram Geometric Prism) -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2310B981' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 2L2 7l10 5 10-5-10-5z'/><path d='M2 17l10 5 10-5'/><path d='M2 12l10 5 10-5'/></svg>">

  <!-- Open Graph / Facebook / WhatsApp Preview Meta -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://apexomniai.com/">
  <meta property="og:title" content="ApexOmni AI | 24/7 AI Receptionists for High-Ticket Local Businesses">
  <meta property="og:description" content="Turn every DM, comment, and midnight website visit into confirmed, paid appointments. 24/7 calendar sync across WhatsApp, Instagram, TikTok, and Web.">
  <meta property="og:image" content="https://apexomniai.com/og-preview.png">

  <!-- Twitter Card Meta -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="https://apexomniai.com/">
  <meta name="twitter:title" content="ApexOmni AI | 24/7 AI-Powered Booking Receptionists">
  <meta name="twitter:description" content="Turn every DM, comment, and midnight website visit into confirmed, paid appointments.">
  <meta name="twitter:image" content="https://apexomniai.com/og-preview.png">

  <!-- Google Fonts: Plus Jakarta Sans, Inter, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Cal.com Official Embed Code for Instant Calendar Audits -->
  <script>
    (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
    Cal("init", {origin:"https://app.cal.com"});
    Cal("ui", {"styles":{"branding":{"brandColor":"#10B981"}},"hideEventTypeDetails":false,"layout":"month_view"});
  </script>

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            obsidian: {
              DEFAULT: '#0B0F19',
              50: '#1A2338',
              100: '#141C2E',
              200: '#111827',
              300: '#0F1626',
              900: '#06090F'
            },
            emerald: {
              300: '#6EE7B7',
              400: '#34D399',
              500: '#10B981',
              600: '#059669',
              700: '#047857'
            },
            violet: {
              300: '#C4B5FD',
              400: '#A78BFA',
              500: '#8B5CF6',
              600: '#6366F1',
              700: '#4F46E5'
            }
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', '"Inter"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace']
          },
          boxShadow: {
            'glow-emerald': '0 0 35px -5px rgba(16, 185, 129, 0.28)',
            'glow-violet': '0 0 35px -5px rgba(99, 102, 241, 0.28)',
            'glass-card': '0 8px 32px 0 rgba(0, 0, 0, 0.45)'
          }
        }
      }
    };
  </script>

  <style>
    :root {
      color-scheme: dark;
    }
    body {
      background-color: #0B0F19;
      color: #E2E8F0;
      font-feature-settings: "cv02", "cv03", "cv04", "cv11";
      overflow-x: hidden;
    }

    /* Ambient Background Mesh */
    .bg-mesh-glow {
      background-image: 
        radial-gradient(circle at 18% 12%, rgba(16, 185, 129, 0.12) 0%, transparent 40%),
        radial-gradient(circle at 82% 16%, rgba(99, 102, 241, 0.14) 0%, transparent 44%),
        radial-gradient(circle at 50% 50%, rgba(16, 185, 129, 0.08) 0%, transparent 48%),
        radial-gradient(circle at 85% 82%, rgba(99, 102, 241, 0.11) 0%, transparent 45%),
        radial-gradient(circle at 15% 90%, rgba(16, 185, 129, 0.09) 0%, transparent 45%);
    }

    /* Glassmorphism Classes */
    .glass-panel {
      background: rgba(17, 24, 39, 0.68);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      position: relative;
    }
    .glass-panel-elevated {
      background: rgba(20, 28, 46, 0.78);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.12);
    }
    .glass-input {
      background: rgba(11, 15, 25, 0.75);
      border: 1px solid rgba(255, 255, 255, 0.12);
    }
    .glass-input:focus {
      border-color: #10B981;
      outline: none;
      box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
    }

    /* Animated Border Glow */
    @keyframes border-rotate {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    .btn-gradient-glow {
      background: linear-gradient(90deg, #10B981, #6366F1, #10B981);
      background-size: 200% 200%;
      animation: border-rotate 4s ease infinite;
    }

    /* Range Slider Styling */
    input[type=range] {
      -webkit-appearance: none;
      background: #1E293B;
      border-radius: 9999px;
      height: 8px;
    }
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      height: 22px;
      width: 22px;
      border-radius: 50%;
      background: #10B981;
      cursor: pointer;
      box-shadow: 0 0 14px rgba(16, 185, 129, 0.7);
      border: 2px solid #FFFFFF;
      transition: transform 0.1s ease;
    }
    input[type=range]::-webkit-slider-thumb:hover {
      transform: scale(1.15);
    }
    input[type=range]::-moz-range-thumb {
      height: 22px;
      width: 22px;
      border-radius: 50%;
      background: #10B981;
      cursor: pointer;
      box-shadow: 0 0 14px rgba(16, 185, 129, 0.7);
      border: 2px solid #FFFFFF;
    }

    /* Typing Dots Animation */
    @keyframes typingBounce {
      0%, 80%, 100% { transform: translateY(0); opacity: 0.35; }
      40% { transform: translateY(-5px); opacity: 1; }
    }
    .typing-dot:nth-child(1) { animation: typingBounce 1s infinite 0.1s; }
    .typing-dot:nth-child(2) { animation: typingBounce 1s infinite 0.25s; }
    .typing-dot:nth-child(3) { animation: typingBounce 1s infinite 0.4s; }

    /* Custom Chat Scrollbar */
    .chat-scroll::-webkit-scrollbar {
      width: 4px;
    }
    .chat-scroll::-webkit-scrollbar-track {
      background: transparent;
    }
    .chat-scroll::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.16);
      border-radius: 4px;
    }

    /* Modal Backdrop */
    dialog::backdrop {
      background: rgba(6, 9, 15, 0.85);
      backdrop-filter: blur(8px);
    }

    /* Interactive Spotlight Highlight */
    .spotlight-card::before {
      content: "";
      position: absolute;
      top: var(--mouse-y, -1000px);
      left: var(--mouse-x, -1000px);
      width: 380px;
      height: 380px;
      background: radial-gradient(circle, rgba(16, 185, 129, 0.08) 0%, transparent 60%);
      transform: translate(-50%, -50%);
      pointer-events: none;
      border-radius: 50%;
      z-index: 1;
    }
  </style>
</head>
<body class="bg-obsidian text-slate-200 antialiased bg-mesh-glow min-h-screen flex flex-col selection:bg-emerald-500/30 selection:text-emerald-300">

  <!-- ============================================================== -->
  <!-- 1. STICKY NAVIGATION BAR                                       -->
  <!-- ============================================================== -->
  <header class="sticky top-0 z-50 w-full border-b border-white/[0.07] bg-obsidian/85 backdrop-blur-xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <!-- Brand Logo & Uptime Status -->
      <div class="flex items-center gap-4">
        <a href="#hero" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 rounded-lg p-1">
          <!-- Geometric Monogram Icon -->
          <div class="relative w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-violet-600 p-[1px] shadow-lg shadow-emerald-500/10">
            <div class="w-full h-full bg-obsidian-900 rounded-[11px] flex items-center justify-center">
              <svg class="w-5 h-5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                <path d="M2 17l10 5 10-5"></path>
                <path d="M2 12l10 5 10-5"></path>
              </svg>
            </div>
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-extrabold tracking-tight text-white group-hover:text-emerald-400 transition-colors">
              ApexOmni<span class="text-emerald-400 font-normal">.AI</span>
            </span>
            <span class="text-[10px] tracking-wider uppercase font-semibold text-slate-400">High-Ticket Receptionists</span>
          </div>
        </a>

        <!-- System Uptime Badge -->
        <div class="hidden md:inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-xs font-medium text-emerald-400">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>99.9% Uptime</span>
        </div>
      </div>

      <!-- Navigation Anchors -->
      <nav class="hidden lg:flex items-center gap-6 xl:gap-7 text-sm font-medium text-slate-300">
        <a href="#channels" class="hover:text-white transition-colors">Channels</a>
        <a href="#simulator" class="hover:text-emerald-400 transition-colors flex items-center gap-1.5">
          <span>Live Simulator</span>
          <span class="px-1.5 py-0.5 text-[10px] font-bold rounded bg-violet-600/30 text-violet-300 border border-violet-500/30">Interactive</span>
        </a>
        <a href="#roi-calculator" class="hover:text-white transition-colors">ROI Calculator</a>
        <a href="#case-studies" class="hover:text-white transition-colors">Case Studies</a>
        <a href="#pricing" class="hover:text-white transition-colors">Pricing</a>
        <a href="#guarantee" class="hover:text-white transition-colors">Guarantee</a>
      </nav>

      <!-- Header CTA & Mobile Menu Toggle -->
      <div class="flex items-center gap-3">
        <!-- Glowing Pilot CTA -->
        <button onclick="openLeadModal('Navigation CTA - 14-Day Free Pilot')" class="relative p-[1px] rounded-xl overflow-hidden group focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400">
          <div class="absolute inset-0 btn-gradient-glow opacity-85 group-hover:opacity-100 transition-opacity"></div>
          <div class="relative px-4 sm:px-5 py-2.5 rounded-[11px] bg-obsidian-900 transition-all duration-300 group-hover:bg-opacity-80 flex items-center gap-2">
            <span class="text-xs sm:text-sm font-bold text-white tracking-wide">Claim 14-Day Free Pilot</span>
            <svg class="w-4 h-4 text-emerald-400 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="M12 5l7 7-7 7"></path>
            </svg>
          </div>
        </button>

        <!-- Mobile Menu Button -->
        <button id="mobileMenuBtn" aria-label="Toggle navigation menu" class="lg:hidden p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800/60 focus:outline-none">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Drawer Navigation -->
    <div id="mobileMenu" class="hidden lg:hidden border-b border-white/[0.08] bg-obsidian-900/95 px-6 py-6 space-y-4 backdrop-blur-2xl">
      <div class="flex flex-col space-y-3 font-medium text-slate-200">
        <a href="#channels" onclick="closeMobileMenu()" class="hover:text-emerald-400 py-1">Channels</a>
        <a href="#simulator" onclick="closeMobileMenu()" class="hover:text-emerald-400 py-1 flex items-center justify-between">
          <span>Live Simulator</span>
          <span class="text-xs px-2 py-0.5 rounded bg-violet-600/30 text-violet-300 border border-violet-500/30">Interactive</span>
        </a>
        <a href="#roi-calculator" onclick="closeMobileMenu()" class="hover:text-emerald-400 py-1">ROI Calculator</a>
        <a href="#comparison" onclick="closeMobileMenu()" class="hover:text-emerald-400 py-1">Problem vs Solution</a>
        <a href="#case-studies" onclick="closeMobileMenu()" class="hover:text-emerald-400 py-1">Case Studies</a>
        <a href="#process" onclick="closeMobileMenu()" class="hover:text-emerald-400 py-1">Implementation</a>
        <a href="#pricing" onclick="closeMobileMenu()" class="hover:text-emerald-400 py-1">Pricing</a>
        <a href="#guarantee" onclick="closeMobileMenu()" class="hover:text-emerald-400 py-1">Guarantee</a>
        <a href="#faq" onclick="closeMobileMenu()" class="hover:text-emerald-400 py-1">FAQ</a>
      </div>
      <div class="pt-3 border-t border-slate-800 flex items-center justify-between">
        <div class="inline-flex items-center gap-2 text-xs text-emerald-400">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>99.9% Uptime Verified</span>
        </div>
      </div>
    </div>
  </header>

  <main class="flex-1">

    <!-- ============================================================== -->
    <!-- 2. ABOVE-THE-FOLD HERO SECTION                                 -->
    <!-- ============================================================== -->
    <section id="hero" class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Hero Left Column: Copy & Value Proposition -->
          <div class="lg:col-span-7 flex flex-col items-start text-left space-y-6">
            
            <!-- Social Proof Pill -->
            <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full glass-panel border-slate-700/60 shadow-inner text-xs sm:text-sm text-slate-300">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
              </svg>
              <span class="font-semibold text-emerald-400">Verified Results</span>
              <span class="text-slate-500">|</span>
              <span>Trusted by 65+ Clinics &amp; Local Service Businesses across UK, US &amp; Canada</span>
            </div>

            <!-- Main Value Headline -->
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.12]">
              Turn Every DM, Comment, and Midnight Website Visit Into a 
              <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-violet-400 bg-clip-text text-transparent">
                Confirmed, Paid Appointment.
              </span>
            </h1>

            <!-- Subheadline -->
            <p class="text-lg sm:text-xl text-slate-300 font-normal leading-relaxed max-w-2xl">
              Stop losing <strong class="text-white font-semibold">$3,000+ every week</strong> to delayed replies and missed calls. We deploy trained AI receptionists natively inside your <span class="text-emerald-400 font-medium">Website</span>, <span class="text-emerald-400 font-medium">WhatsApp Business</span>, <span class="text-emerald-400 font-medium">Instagram DMs</span>, and <span class="text-emerald-400 font-medium">TikTok</span> to qualify prospects and book slots into your calendar in under 20 seconds.
            </p>

            <!-- Dual Call-to-Action -->
            <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto">
              <!-- Primary CTA -->
              <button onclick="openLeadModal('Hero Primary - Deploy Bot')" class="px-8 py-4 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-obsidian-900 font-bold text-base shadow-lg shadow-emerald-500/25 hover:shadow-emerald-500/40 transform hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2.5">
                <span>Deploy Your 14-Day Free Bot</span>
                <svg class="w-5 h-5 text-obsidian-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"></path>
                  <path d="M12 5l7 7-7 7"></path>
                </svg>
              </button>

              <!-- Secondary CTA -->
              <a href="#simulator" class="px-7 py-4 rounded-xl glass-panel hover:bg-slate-800/80 text-white font-semibold text-base border border-slate-700/80 hover:border-slate-600 transition-all flex items-center justify-center gap-2">
                <span>Launch Interactive Simulator</span>
                <svg class="w-4 h-4 text-emerald-400 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <polyline points="19 12 12 19 5 12"></polyline>
                </svg>
              </a>
            </div>

            <!-- Mini Trust Note -->
            <div class="flex flex-wrap items-center gap-6 pt-1 text-xs text-slate-400">
              <div class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Zero Setup Fee During Pilot</span>
              </div>
              <div class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Live in 48-72 Hours</span>
              </div>
              <div class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>No Credit Card Required</span>
              </div>
            </div>

          </div>

          <!-- Hero Right Column: Live Booking Teaser Card -->
          <div class="lg:col-span-5 flex justify-center lg:justify-end">
            <div class="w-full max-w-md relative">
              <div class="absolute -top-12 -right-12 w-64 h-64 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>
              <div class="absolute -bottom-10 -left-10 w-64 h-64 bg-violet-600/20 rounded-full blur-3xl pointer-events-none"></div>

              <div class="relative glass-panel-elevated p-6 rounded-2xl border border-white/10 shadow-2xl space-y-5">
                <div class="flex items-center justify-between border-b border-white/[0.08] pb-4">
                  <div class="flex items-center gap-3">
                    <div class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></div>
                    <div>
                      <h4 class="text-sm font-bold text-white">Live Booking Activity</h4>
                      <p class="text-xs text-slate-400">Omnichannel automated sync</p>
                    </div>
                  </div>
                  <span class="text-xs font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20 font-semibold">ONLINE</span>
                </div>

                <div class="space-y-3 text-xs">
                  <div class="p-3 rounded-xl bg-slate-900/80 border border-emerald-500/20 flex items-start gap-3">
                    <div class="w-7 h-7 rounded-lg bg-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0">
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                    </div>
                    <div class="flex-1">
                      <div class="flex items-center justify-between text-slate-400">
                        <span class="font-semibold text-white">WhatsApp Business</span>
                        <span>12s ago</span>
                      </div>
                      <p class="text-slate-300 mt-0.5">Dental Implants consultation booked for <strong>Saturday 2:30 PM</strong></p>
                      <span class="inline-block mt-1 text-[10px] text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 rounded font-mono font-semibold">$4,200 Potential Value</span>
                    </div>
                  </div>

                  <div class="p-3 rounded-xl bg-slate-900/80 border border-violet-500/20 flex items-start gap-3">
                    <div class="w-7 h-7 rounded-lg bg-violet-500/20 flex items-center justify-center text-violet-400 shrink-0">
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                    </div>
                    <div class="flex-1">
                      <div class="flex items-center justify-between text-slate-400">
                        <span class="font-semibold text-white">Instagram Direct</span>
