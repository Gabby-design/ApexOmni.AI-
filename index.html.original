  <!-- LEAD CAPTURE & CALENDAR MODAL (14-DAY FREE PILOT)               -->
  <!-- ============================================================== -->
  <dialog id="leadModal" class="rounded-3xl bg-transparent p-0 max-w-lg w-full m-auto focus:outline-none">
    <div class="glass-panel-elevated rounded-3xl p-6 sm:p-8 border border-emerald-500/40 shadow-2xl relative text-slate-200">
      
      <!-- Close Button -->
      <button onclick="closeLeadModal()" class="absolute top-5 right-5 text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800/80 transition-colors" aria-label="Close modal">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <!-- Modal Mode Switcher Tabs -->
      <div class="flex items-center gap-2 p-1 rounded-xl bg-slate-900/80 border border-white/5 mb-5 text-xs font-semibold">
        <button id="tabLeadFormBtn" onclick="showLeadTab('form')" class="flex-1 py-2 rounded-lg bg-emerald-500 text-obsidian-900 transition-all font-bold">
          Quick Pilot Claim
        </button>
        <button id="tabLeadCalBtn" onclick="showLeadTab('cal')" class="flex-1 py-2 rounded-lg text-slate-400 hover:text-white transition-all">
          Schedule Live Audit
        </button>
      </div>

      <!-- Tab 1: Form Content -->
      <div id="modalFormContainer" class="space-y-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 text-[10px] font-mono font-bold tracking-wide uppercase">
              Double-Protected 14-Day Pilot
            </span>
            <span id="modalRoiBadge" class="hidden text-[10px] font-mono font-bold text-emerald-300 bg-slate-800 px-2 py-0.5 rounded border border-emerald-500/30">
              Recovery Target: $3,250/mo
            </span>
          </div>
          <h3 class="text-2xl font-extrabold text-white mt-1.5">Claim Your Free AI Receptionist</h3>
          <p class="text-xs text-slate-300 mt-1">
            Zero setup fees, zero credit card, and guaranteed 5 bookings during your 14-day pilot.
          </p>
        </div>

        <form id="pilotLeadForm" onsubmit="handleLeadSubmit(event)" class="space-y-3.5 text-xs">
          <input type="hidden" id="formSourceContext" value="General">

          <div>
            <label for="leadBusinessName" class="block font-semibold text-slate-300 mb-1">Clinic / Business Name *</label>
            <input type="text" id="leadBusinessName" required placeholder="e.g. Apex Aesthetic &amp; Dental Care" class="w-full px-3.5 py-2.5 rounded-xl glass-input text-white text-xs">
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="leadIndustry" class="block font-semibold text-slate-300 mb-1">Industry Sector *</label>
              <select id="leadIndustry" required class="w-full px-3 py-2.5 rounded-xl glass-input text-white text-xs bg-slate-900">
                <option value="Aesthetic Clinic">Aesthetic Clinic</option>
                <option value="Dental Center">Dental Center</option>
                <option value="Medspa">Medical Spa</option>
                <option value="High-Ticket Contractor">High-Ticket Contractor</option>
                <option value="Other High-Ticket">Other High-Ticket Service</option>
              </select>
            </div>

            <div>
              <label for="leadPrimaryChannel" class="block font-semibold text-slate-300 mb-1">Priority Channel *</label>
              <select id="leadPrimaryChannel" required class="w-full px-3 py-2.5 rounded-xl glass-input text-white text-xs bg-slate-900">
                <option value="WhatsApp Business">WhatsApp Business</option>
                <option value="Instagram DMs">Instagram DMs</option>
                <option value="Website Widget">Website Widget</option>
                <option value="TikTok Inquiries">TikTok Inquiries</option>
                <option value="All 4 Omnichannel">All 4 Channels (Full Suite)</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="leadEmail" class="block font-semibold text-slate-300 mb-1">Work Email Address *</label>
              <input type="email" id="leadEmail" required placeholder="director@apexclinic.com" class="w-full px-3.5 py-2.5 rounded-xl glass-input text-white text-xs">
            </div>

            <div>
              <label for="leadPhone" class="block font-semibold text-slate-300 mb-1">Direct Mobile / WhatsApp *</label>
              <input type="tel" id="leadPhone" required placeholder="+1 (555) 234-5678" class="w-full px-3.5 py-2.5 rounded-xl glass-input text-white text-xs">
            </div>
