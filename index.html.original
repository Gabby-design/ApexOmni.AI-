                </li>
              </ul>
            </div>

            <div class="mt-8 pt-4 border-t border-rose-500/20 text-xs text-rose-400 font-mono">
              Estimated Monthly Cost: $3,200+ in lost leads &amp; desk overhead
            </div>
          </div>

          <!-- Emerald Card: The ApexOmni AI Standard -->
          <div class="p-8 rounded-3xl bg-slate-900/90 border border-emerald-500/40 shadow-glow-emerald relative overflow-hidden flex flex-col justify-between">
            <div class="space-y-6">
              <div class="flex items-center justify-between border-b border-emerald-500/20 pb-4">
                <div>
                  <span class="text-xs font-mono font-semibold uppercase text-emerald-400 tracking-wider">AI Automated Standard</span>
                  <h3 class="text-xl font-bold text-white mt-1">The ApexOmni AI Standard</h3>
                </div>
                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center border border-emerald-500/30">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
              </div>

              <ul class="space-y-4 text-sm text-slate-200">
                <li class="flex items-start gap-3">
                  <div class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  </div>
                  <div>
                    <strong class="text-white">Lightning-fast replies in seconds across all 4 channels, 24/7/365:</strong> Your AI handles Website, WhatsApp, IG, and TikTok simultaneously with zero wait time.
